<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- HiveTest 造数：HDFS 客户端运行时极吵（每写一个 packet 就 3 行 DEBUG，而且 N 个
         写线程一起刷），这里整片压到 WARN，只留警告和错误。程序自己的进度输出走
         System.out，不受日志级别影响。 -->
    <logger name="org.apache.hadoop" level="WARN"/>
    <logger name="org.apache.hive" level="WARN"/>
    <logger name="org.apache.orc" level="WARN"/>
    <logger name="org.apache.arrow" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.dojao" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
