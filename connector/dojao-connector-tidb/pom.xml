<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dojao</groupId>
        <artifactId>dojao</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>dojao-connector-tidb</artifactId>
    <name>Dojao Connector TiDB</name>
    <description>
        TiDB 连接器：MySQL 线路协议（Connector/J），表扫描、谓词下推、分区并行读取、
        CTAS 建表、写入与 INSERT OVERWRITE。行数估算走 TiDB 的 EXPLAIN estRows。
        catalog = JDBC 连接串指向的 TiDB 集群，schema = DATABASE，table = 表。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.dojao</groupId>
            <artifactId>dojao-spi</artifactId>
        </dependency>

        <!-- TiDB 走 MySQL 线路协议，复用 MySQL Connector/J -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 测试用：离线探针需要真实 Arrow 分配器（arrow-vector 只带接口）。
             test 作用域，不进运行时也不污染插件 jar。 -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
