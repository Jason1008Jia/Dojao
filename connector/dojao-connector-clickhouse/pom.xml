<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dojao</groupId>
        <artifactId>dojao</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>dojao-connector-clickhouse</artifactId>
    <name>Dojao Connector ClickHouse</name>
    <description>ClickHouse 连接器（JDBC）：表扫描、谓词下推、分区并行读取</description>

    <dependencies>
        <dependency>
            <groupId>com.dojao</groupId>
            <artifactId>dojao-spi</artifactId>
        </dependency>

        <!-- ClickHouse JDBC（HTTP 协议） -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
        </dependency>

        <!-- ClickHouse JDBC 默认用 Apache HttpClient 5 连接池；精简 jar 不带该客户端，
             缺失时会打印「NoClassDefFoundError: org/apache/hc/core5/http/HttpRequest」
             并降级到 HttpURLConnection。显式补齐后恢复连接复用。
             slf4j-api 排除：沿用引擎的 2.x，禁止 HttpClient 的 1.7.x 传递版本覆盖。 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ClickHouse JDBC 默认 compress=lz4，编解码实现（net.jpountz.lz4 包）不在精简 jar 内；
             缺失时连接/查询直接抛「LZ4 is not supported」。引入后保留默认压缩，
             不必降级为 gzip，也不必在 URL 上加 compress=0。 -->
        <dependency>
            <groupId>org.lz4</groupId>
            <artifactId>lz4-java</artifactId>
        </dependency>
    </dependencies>

</project>
